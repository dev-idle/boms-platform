# =============================================================================
# BOMS API — Environment configuration
# Copy to .env and adjust values. Never commit .env to version control.
# Durations use Go syntax (e.g. 15s, 2m, 1h). See time.ParseDuration.
#
# Local stack: Docker = Redis only. PostgreSQL = Neon (https://neon.tech).
#   docker compose -f scripts/docker-compose.dev.yml up -d
# =============================================================================

# Application
APP_NAME=boms-api
APP_ENV=development
APP_DEBUG=false

# HTTP
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_BODY_LIMIT=1048576
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
# Deadline for one handler; keep below HTTP_WRITE_TIMEOUT. Cancels the queries a
# handler has in flight when the caller walks away.
HTTP_REQUEST_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=120s
# Comma-separated CIDRs of reverse proxies; empty = direct clients. Sets X-Forwarded-For trust + Fiber ProxyHeader.
HTTP_TRUSTED_PROXIES=
# HSTS: max-age seconds on Strict-Transport-Security; 0 = off (use TLS at reverse proxy; enable when appropriate)
HTTP_HSTS_MAX_AGE=0
# Shared secret with the Next.js proxy (X-Internal-Secret header). Min 32 chars in staging/production.
# Empty in development disables enforcement. MUST match frontend INTERNAL_PROXY_SECRET.
HTTP_INTERNAL_SECRET=

# CORS (comma-separated origins)
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=86400

# Rate limit (per IP, in-memory — global Fiber middleware)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60s

# Redis rate limits (auth routes + admin writes)
RATE_LIMIT_REDIS_AUTH_ATTEMPT_MAX=5
RATE_LIMIT_REDIS_AUTH_ATTEMPT_WINDOW=1m
RATE_LIMIT_REDIS_AUTH_REFRESH_MAX=10
RATE_LIMIT_REDIS_AUTH_REFRESH_WINDOW=1m
RATE_LIMIT_REDIS_AUTH_LOGOUT_MAX=10
RATE_LIMIT_REDIS_AUTH_LOGOUT_WINDOW=1m
RATE_LIMIT_REDIS_ADMIN_WRITE_MAX=30
RATE_LIMIT_REDIS_ADMIN_WRITE_WINDOW=1m
# Manager catalog writes (products, combos, discount codes)
RATE_LIMIT_REDIS_MANAGER_WRITE_MAX=30
RATE_LIMIT_REDIS_MANAGER_WRITE_WINDOW=1m
# Order mutations (customer checkout, staff/baker status transitions)
RATE_LIMIT_REDIS_ORDER_WRITE_MAX=20
RATE_LIMIT_REDIS_ORDER_WRITE_WINDOW=1m
# Discount code attempts (PUT /cart/discount) per customer — each answer says
# whether a code exists, so the cap stops the code space being walked
RATE_LIMIT_REDIS_DISCOUNT_ATTEMPT_MAX=10
RATE_LIMIT_REDIS_DISCOUNT_ATTEMPT_WINDOW=15m
# Realtime tickets (POST /realtime/tickets) per user — every open tab asks for a
# new one after each token refresh, so this sits well above one per tab
RATE_LIMIT_REDIS_REALTIME_TICKET_MAX=60
RATE_LIMIT_REDIS_REALTIME_TICKET_WINDOW=1m
# Personal data exports (GET /me/export) per user — each reads everything the
# bakery holds about the person, so a stolen session cannot pull it in a loop
RATE_LIMIT_REDIS_DATA_EXPORT_MAX=5
RATE_LIMIT_REDIS_DATA_EXPORT_WINDOW=1h
# Following an emailed link (confirm email, reset password) per IP — fails
# closed: link tokens are unguessable, the cap bounds how hard anyone can try
RATE_LIMIT_REDIS_AUTH_LINK_MAX=10
RATE_LIMIT_REDIS_AUTH_LINK_WINDOW=15m
# Asking for a password reset link per IP — fails closed
RATE_LIMIT_REDIS_PASSWORD_RESET_MAX=5
RATE_LIMIT_REDIS_PASSWORD_RESET_WINDOW=15m
# Reset links sent to one account, whoever asks — bounds the emails a stranger
# can send to a customer's inbox from many addresses
RATE_LIMIT_REDIS_PASSWORD_RESET_ACCOUNT_MAX=3
RATE_LIMIT_REDIS_PASSWORD_RESET_ACCOUNT_WINDOW=1h
# Asking for a new confirmation email per user
RATE_LIMIT_REDIS_VERIFICATION_RESEND_MAX=3
RATE_LIMIT_REDIS_VERIFICATION_RESEND_WINDOW=1h
# Self-service account writes (PATCH /me, PATCH /me/password, DELETE /me) —
# bounds old-password guessing and phone-number probing through the duplicate check
RATE_LIMIT_REDIS_SELF_WRITE_MAX=10
RATE_LIMIT_REDIS_SELF_WRITE_WINDOW=1m
# Cloudinary signature issuance (manager) — separate from catalog writes
RATE_LIMIT_REDIS_MANAGER_MEDIA_MAX=20
RATE_LIMIT_REDIS_MANAGER_MEDIA_WINDOW=1m
RATE_LIMIT_REDIS_AUTH_USER_MAX=60
RATE_LIMIT_REDIS_AUTH_USER_WINDOW=1m

# PostgreSQL — Neon (dashboard → connection string; prefer sslmode=require)
# Apply schema: make atlas-apply (requires Atlas CLI + POSTGRES_URL)
# staging/production: sslmode=disable|allow rejected by config.
POSTGRES_URL=
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=15m
POSTGRES_HEALTH_TIMEOUT=5s
# Server-side cap on one statement. An abandoned request keeps its connection
# until the statement ends, so this is what stops a slow query starving the pool.
POSTGRES_STATEMENT_TIMEOUT=10s

# Redis — local Docker (see scripts/docker-compose.dev.yml)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s
REDIS_HEALTH_TIMEOUT=2s

# Event outbox — committed order changes are published to Redis right after the
# commit (API) and swept up by the worker (cmd/worker) if that delivery failed.
# SWEEP_GRACE must be longer than twice DISPATCH_TIMEOUT.
OUTBOX_DISPATCH_TIMEOUT=5s
OUTBOX_SWEEP_INTERVAL=30s
OUTBOX_SWEEP_GRACE=15s
OUTBOX_SWEEP_BATCH=100
OUTBOX_RETENTION=168h
OUTBOX_PRUNE_INTERVAL=1h

# Email — sent by the worker (cmd/worker) from its queue in Redis. The defaults
# send to Mailpit (scripts/docker-compose.dev.yml), which keeps every message and
# delivers none: read them at http://localhost:8025. In staging/production
# MAIL_SMTP_TLS must be starttls (port 587) or tls (port 465), the credentials
# are required and MAIL_SITE_URL must be https.
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_TLS=none
MAIL_FROM_ADDRESS=orders@chouxbakery.example
MAIL_FROM_NAME=Choux
# Where a customer's reply goes — the bakery's inbox.
MAIL_REPLY_TO=hello@chouxbakery.example
# The storefront origin links in emails point to.
MAIL_SITE_URL=http://localhost:3000
# At most 10s: a send can take twice this, inside the email task's deadline.
MAIL_SEND_TIMEOUT=10s
# Emails one worker sends at once.
MAIL_CONCURRENCY=4

# Realtime — push-only WebSocket listener, separate from the API port. Browsers
# connect to it directly (not through the BFF) with a ticket from
# POST /api/v1/realtime/tickets. PUBLIC_URL is what browsers dial (wss:// outside
# development); ALLOWED_ORIGINS are the exact site origins allowed to connect.
REALTIME_ADDR=127.0.0.1:8081
REALTIME_PUBLIC_URL=ws://localhost:8081/ws
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
REALTIME_TICKET_TTL=30s
# How often an open socket checks its session still exists (logout, revocation,
# token refresh), and the longest a socket lives before it must re-ticket.
REALTIME_SESSION_CHECK_INTERVAL=30s
REALTIME_MAX_LIFETIME=1h
REALTIME_PING_INTERVAL=25s
REALTIME_WRITE_TIMEOUT=10s
# Longest a handshake may take, from its first byte to the answer.
REALTIME_HANDSHAKE_TIMEOUT=10s
# Events queued per socket before a slow reader is dropped (it reconnects).
REALTIME_SEND_BUFFER=16
REALTIME_MAX_CONNS_PER_USER=20
# Connections one process holds, open sockets included.
REALTIME_MAX_CONNS=10000
# Handshakes redeemed per second per process, and the share of them one client
# address may use — a flood of forged tickets cannot starve the Redis pool the
# API authenticates with, and one host cannot take the whole budget.
REALTIME_ADMISSION_RATE=200
REALTIME_ADMISSION_RATE_PER_ADDRESS=10
# Edge proxies (IPs or CIDR ranges) whose X-Forwarded-For names the client;
# empty means browsers connect directly and the peer address is the client.
REALTIME_TRUSTED_PROXIES=

# Logging
LOG_LEVEL=info
LOG_ENCODING=json
LOG_ENABLE_CALLER=false
LOG_ENABLE_STACKTRACE=false

# JWT — Ed25519 (base64-encoded 32-byte seed). Dev: auto-generated when unset.
# Generate: go run ./cmd/genkey   (or: openssl rand -base64 32)
JWT_ED25519_PRIVATE_KEY=
JWT_ISSUER=boms-api
JWT_AUDIENCE=boms
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Server-side sessions (Redis)
SESSION_TTL=168h

# HttpOnly cookies (auth handlers)
COOKIE_NAME=boms_refresh
# Signed-in role, read by the Next.js proxy to route a returning visitor without
# a flash of the wrong page. A hint only — never trusted for authorization.
COOKIE_ROLE_NAME=boms_role
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Argon2id password hashing (memory in KiB)
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# Development-only admin accounts (APP_ENV=development). Seeded at API boot.
# Primary admin plus optional extras for backup / real-email testing.
# Other roles (staff, baker, manager, customer) are created via register or admin UI.
SEED_DEV_ADMIN_EMAIL=admin@boms.com
SEED_DEV_ADMIN_PASSWORD=ChangeMe@123
SEED_DEV_ADMIN_FULL_NAME=Development Admin
SEED_DEV_ADMIN_PHONE=
# Extras format: email|password|full_name[|phone] — multiple entries separated by ;
SEED_DEV_ADMIN_EXTRAS=second.admin@example.com|ChangeMe@123|Second Admin

# Cloudinary — product image uploads (manager signed upload).
# Required when APP_ENV is staging or production. API secret stays backend-only.
# Frontend: NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME (+ optional NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDER).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=boms/products
